{
 "version": "0.1.63",
 "states": {
  "UCEdInfoLink.Playing": [
   "Begin:",
   "if (Plr() == None || Talking() || OtherPlaying())",
   "{",
   "Sleep(0.5);",
   "Goto('Begin');",
   "}",
   "bPlaying = True;",
   "if (!bQuickStart)",
   "Sleep(0.5);",
   "Log(\"UCEd: InfoLink from\" @ caller @ \"(\" $ numLines @ \"lines)\");",
   "InfoStart(caller);",
   "if (!bQuickStart)",
   "Sleep(1.5);",
   "n = 0;",
   "Next:",
   "d = InfoLine(n);",
   "if (d >= 0)",
   "{",
   "Sleep(d);"
  ],
  "UCLink.Running": [
   "Begin:",
   "Step = 0;",
   "Waited = 0;",
   "Runs = 0;",
   "bHurry = False;",
   "Next:",
   "if (Step < 0 || Step >= ArrayCount(Act) || Act[Step] == \"\")",
   "{",
   "GotoState('');",
   "Stop;",
   "}",
   "Delay = float(Field(Act[Step], 0));",
   "if (bSteps)",
   "{",
   "Runs++;",
   "if (Runs > 256)",
   "{",
   "Report(\"fail\", \"steps||loop\");",
   "GotoState('');",
   "Stop;",
   "}",
   "if (!bHurry && Delay > 0)",
   "Sleep(Delay);",
   "if (Field(Act[Step], 1) == \"until\")",
   "{",
   "UntilStart = Level.TimeSeconds;",
   "Goto('Until');",
   "}",
   "Step = DoStep(Step);",
   "Goto('Next');",
   "}",
   "if (!bHurry && Delay > Waited)",
   "{",
   "Sleep(Delay - Waited);",
   "Waited = Delay;",
   "}",
   "DoAct(Act[Step]);",
   "Step++;",
   "Goto('Next');",
   "Until:",
   "if (!UntilDone(Act[Step]))",
   "{",
   "Sleep(0.25);"
  ]
 }
}
