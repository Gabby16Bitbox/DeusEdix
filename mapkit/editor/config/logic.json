    "keypress": {"hears": "key", "tag": "UCL_Key_{key}", "label": "JC presses a key", "say": "JC presses {key}",
      "args": [{"id": "key", "type": "text", "label": "key", "default": "K", "empty": "?"}], "level": "more", "games": ["revision", "vanilla"],
      "kw": ["key", "press", "button", "keyboard", "input", "hotkey"]},
    "animdone": {"hears": "motion", "tag": "UCL_{src}_Anim", "label": "its animation has finished",
      "say": "the animation of {src} has finished", "level": "basic", "games": ["revision", "vanilla"],
      "kw": ["animation", "motion", "finished"]},
    "bodydone": {"hears": "npcuse", "tag": "UCL_{src}_Body", "label": "its body animation has finished",
