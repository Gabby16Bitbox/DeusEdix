    {"id": "object", "classes": ["DeusExDecoration"], "outputs": ["used", "gone", "npcused", "near"], "inputs": ["hide", "show", "sound", "explode", "effect"]},
    {"id": "timer", "noun": "timer", "classes": ["UCTimer"], "outputs": ["finished", "stopped"], "inputs": ["timerstart", "timerstop", "timerpause", "timerresume"]},
    {"id": "cutscene", "classes": ["UCCutscene"], "outputs": ["cutstart", "cutdone"], "inputs": ["cutplay", "cutstop"]},
    {"id": "effectpoint", "noun": "effect point", "classes": ["UCEffectPoint"], "outputs": ["near"], "inputs": ["effect"]},
    {"id": "script", "noun": "script", "classes": ["UCScript"], "outputs": ["near"], "inputs": ["on", "off", "sound", "explode", "effect"],
     "note": "Its declared outputs and inputs (Tools > Scripts, editor/scripts.py ports) come first."}
  ],
  "about_v2": "Version 2 adds the one vocabulary every view reads (static/logic-vocab.js, logic_catalog.py): each output and verb has its label (the menus and the 'When it...' / 'It can...' chips), its sentence ('say', after sentence.when: today 'When', 'As soon as' after the rename pass), its arguments by type, the verb that undoes it ('inverse'), the games it works in, its disclosure level and search keywords. 'say' is a template, or a list of {if, say} tried in order (the last has no if): {name} is a word of the sentence or an argument shown by its type ({b:amount}: by another type), [...] is left out when a value in it is empty, 'many' is the sentence for objects tagged alike, 'pieces' are named parts of 'say', 'labels' a label by the target's family. movers: the words of a mover by what it is (door, bridge, lift...). pairs: the first choices of Connect, by the family of the source and of the target, the first first (no 'when': the source's first output); asks: the fields a pair asks for.",
  "levels": ["basic", "more", "advanced"],
  "games": ["revision", "vanilla"],
  "types": {
    "text": "any text",
    "line": "a text JC reads: sentences quote its first 60 characters",
    "state": "a state's name (a flag)",
    "counter": "a counter's name",
    "goal": "a goal's name: the same name gives and completes it",
    "map": "a map's name",
    "tag": "an object's Tag",
    "port": "an input or output a script declares",
    "args": "a script input's values, name=value;name=value",
    "choice": "one of its 'choices' [value, label]",
    "toggle": "a word kept when ticked (its 'value')",
    "yesno": "'1' yes, '0' no",
    "bool": "yes or no",
    "look": "a light effect's words: its colour, beep, exact",
    "colour": "the colour of a 'look' (red when it names none)",
    "sound": "a sound, Package.Group.Name: sentences give its last part",
    "object": "an object of the map, by name",
    "place": "a point of the map [x, y, z]",
    "whole": "a whole number as links.py builds it: empty is its default",
    "amount": "a whole number without its sign ('take 2 from')",
    "number": "a number: empty or 0 is its default",
    "seconds": "seconds: sentences give them only when more than 0",
    "floor": "an elevator's floor, 0 or more",
    "button": "a computer's option, 0-3: sentences count from 1",
    "effect": "an effect kind (static/interaction-blocks.js EFFECT_KINDS)"
  },
  "sentence": {
    "rule": "{when}[, only if {checks}]: {steps}[ ({once})]",
    "when": "When {say}",
    "step": "[after {delay} s ]{act}",
    "checks": " and ",
    "steps": ", ",
    "nothing": "nothing yet",
    "once": "only once",
    "tagged": "objects tagged {tag}",
    "area": "{verb}: {count} saved {members}[ + newcomers within {radius} units]",
    "members": {"character": "characters", "light": "lights", "object": "objects"}
  },
