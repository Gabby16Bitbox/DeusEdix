      "kw": ["laser", "beam", "tripwire"]},
    "alarm": {"hears": "event", "tag": "UCL_{src}", "label": "it sounds the alarm", "say": "{src} sounds the alarm",
      "level": "basic", "games": ["revision", "vanilla"], "kw": ["alarm", "siren"]},
    "dies": {"hears": "event", "tag": "UCL_{src}", "label": "they are killed or knocked out",
      "say": "{src} is killed or knocked out", "level": "basic", "games": ["revision", "vanilla"],
      "kw": ["kill", "die", "dead", "death", "knocked out", "unconscious"]},
    "any": {"hears": "event", "tag": "UCL_{src}", "label": "it triggers its event",
      "say": "{src} triggers its event", "level": "basic", "games": ["revision", "vanilla"],
      "kw": ["event", "trigger", "reached"]},
    "picked": {"hears": "watch", "label": "JC picks it up", "say": "JC picks up {src}", "level": "basic",
      "games": ["revision", "vanilla"], "kw": ["item", "pick", "take", "grab"]},
    "gone": {"hears": "watch", "label": "it is destroyed", "say": "{src} is destroyed", "level": "basic",
      "games": ["revision", "vanilla"], "kw": ["destroy", "break", "gone", "body"]},
    "near": {"hears": "watch", "label": "JC comes near", "say": "JC comes within {near} units of {src}",
      "args": [{"id": "near", "type": "number", "label": "within (units)", "default": 256}], "level": "basic",
      "games": ["revision", "vanilla"], "kw": ["near", "approach", "distance", "radius"]},
    "arrived": {"hears": "watch", "label": "they get where they were sent (Walk / Run to a place)",
