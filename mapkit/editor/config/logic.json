      "games": ["revision", "vanilla"], "kw": ["cutscene", "cinematic", "start"]},
    "cutdone": {"hears": "cut", "tag": "UCL_{src}_End", "label": "it has ended (or was skipped)",
      "say": "{src} has ended", "level": "basic", "games": ["revision", "vanilla"],
      "kw": ["cutscene", "end", "skip"]},
    "npcused": {"hears": "npcuse", "tag": "UCL_{src}_Npc", "label": "a character has used it",
      "say": "a character has used {src}", "level": "more", "games": ["revision", "vanilla"],
      "kw": ["character", "npc", "use"]},
    "finished": {"hears": "timer", "tag": "UCL_{src}_Done", "label": "it runs out", "say": "{src} runs out",
      "level": "more", "games": ["revision", "vanilla"], "kw": ["timer", "countdown", "time"]},
    "stopped": {"hears": "timer", "tag": "UCL_{src}_Stop", "label": "an action stops it", "say": "{src} is stopped",
      "level": "more", "games": ["revision", "vanilla"], "kw": ["timer", "stop", "defuse"]},
    "output": {"hears": "port", "label": "it says...", "say": "{src} says \"{port}\"", "port": "it says \"{port}\"",
