{
  "v": 2,
  "about": "What each kind of object offers to the editor's rules (Properties > Interactions): its outputs, what can happen to it, and its inputs, what a rule can make it do. An object's family is the one whose class is its nearest ancestor (editor/logic_catalog.py). outputs: how the game hears each one (editor/LOGIC.md) and the Tag its link waits for ({src}: the object, {option}: a computer's option; none: the link is watched or set off directly). inputs: whether the action needs an object (target). A family's first input is the one a new rule takes. The page's sentences for each id are in static/app.js (LK_WHEN, LK_VERBS).",
  "outputs": {
    "opened": {"hears": "event", "tag": "UCL_{src}", "label": "it has opened", "say": "{src} has opened",
      "level": "basic", "games": ["revision", "vanilla"], "kw": ["door", "open", "opening"]},
    "closed": {"hears": "event", "tag": "UCL_{src}", "label": "it starts closing", "say": "{src} starts closing",
      "level": "basic", "games": ["revision", "vanilla"], "kw": ["door", "close", "shut"]},
    "destroyed": {"hears": "event", "tag": "UCL_{src}", "label": "it is blown up", "say": "{src} is blown up",
      "level": "basic", "games": ["revision", "vanilla"], "kw": ["door", "destroy", "break", "explode"]},
    "used": {"hears": "event", "tag": "UCL_{src}", "label": "JC uses it",
      "say": [{"if": {"usable": true}, "say": "JC has used {src}"}, {"say": "JC uses {src}"}], "level": "basic",
      "games": ["revision", "vanilla"], "kw": ["use", "press", "button", "lever", "switch", "frob"]},
    "code": {"hears": "keypad", "tag": "UCL_{src}", "label": "the right code is typed",
      "say": "the right code is typed on {src}", "level": "basic", "games": ["revision", "vanilla"],
      "kw": ["keypad", "code", "password", "pin"]},
    "wrongcode": {"hears": "fail", "tag": "UCL_{src}_Fail", "label": "a wrong code is typed",
      "say": "a wrong code is typed on {src}", "level": "basic", "games": ["revision", "vanilla"],
      "kw": ["keypad", "code", "wrong", "fail"]},
    "option": {"hears": "option", "tag": "UCL_{src}_Opt{option}", "label": "JC chooses an option of it",
      "say": [{"if": {"optionText": true}, "say": "JC chooses \"{optionText}\" on {src}"},
        {"say": "JC chooses \"option {option}\" on {src}"}],
      "args": [{"id": "option", "type": "button", "label": "Button", "default": 0}], "level": "basic",
      "games": ["revision", "vanilla"], "kw": ["computer", "option", "terminal", "menu", "hack"]},
    "enter": {"hears": "event", "tag": "UCL_{src}", "label": "JC walks in", "say": "JC walks into {src}",
