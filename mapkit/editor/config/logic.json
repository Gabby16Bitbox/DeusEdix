  "about_graph": "Read by the Logic window (static/logic-graph-model.js). setsOff: the outputs an action makes its object say again at once, every time (no time passes: a timer stopped, a cutscene started, a script answering an input; 'output' is any output a script declares), so that rules setting each other off with no delay are found before Play. pieces: the logic's own nodes (edits.logic): each kind's inputs ('in', the verb input's port) and outputs ('out', the output's port) as a script's, 'many' making one per input or output of the item ({n}, its number) or per phase of its list ({name}), and what its live value shows. story: the Story's word for a rule's verb, where they differ (a Story action drawn as a rule's).",
  "setsOff": {
    "timerstop": ["stopped"], "cutplay": ["cutstart"], "cutstop": ["cutdone"],
    "input": ["output"], "on": ["output"], "off": ["output"]
  },
  "pieces": {
    "allof": {"label": "All of", "noun": "block", "level": "more", "kw": ["and", "all", "every", "both"],
      "in": [{"id": "in", "many": "inputs", "label": "input {n}"}, {"id": "reset", "label": "reset"}],
      "out": [{"id": "all", "label": "all done"}], "value": "{done} / {inputs}"},
    "anyof": {"label": "Any of", "noun": "block", "level": "more", "kw": ["or", "any", "either"],
      "in": [{"id": "in", "many": "inputs", "label": "input {n}"}, {"id": "reset", "label": "reset"}],
      "out": [{"id": "any", "label": "one of them"}], "value": ""},
    "firstof": {"label": "First of", "noun": "block", "level": "more", "kw": ["first", "race", "time limit"],
      "in": [{"id": "in", "many": "inputs", "label": "input {n}"}, {"id": "reset", "label": "reset"}],
      "out": [{"id": "first", "many": "inputs", "label": "input {n} came first"}, {"id": "timedout", "label": "timed out"}],
      "value": ""},
    "atleast": {"label": "At least N of these", "noun": "block", "level": "more", "kw": ["enough", "switches", "levers"],
      "in": [], "out": [{"id": "reached", "label": "enough are on"}, {"id": "lost", "label": "no longer enough"}],
      "value": "{on} / {need}"},
    "counter": {"label": "Counter", "noun": "block", "level": "more", "kw": ["count", "times", "number"],
      "in": [{"id": "add", "label": "add one"}, {"id": "take", "label": "take one back"}, {"id": "reset", "label": "reset"}],
      "out": [{"id": "reached", "label": "reaches {goal}"}, {"id": "changed", "label": "changed"}], "value": "{value} / {goal}"},
    "gate": {"label": "Gate", "noun": "block", "level": "more", "kw": ["gate", "allow", "block", "pass"],
      "in": [{"id": "in", "label": "pass through"}, {"id": "open", "label": "open"}, {"id": "close", "label": "close"},
        {"id": "toggle", "label": "open or close"}], "out": [{"id": "out", "label": "passed"}], "value": "{state}"},
    "switch": {"label": "Switch", "noun": "block", "level": "more", "kw": ["switch", "sequence", "random", "next"],
      "in": [{"id": "in", "label": "next"}, {"id": "reset", "label": "reset"}],
      "out": [{"id": "out", "many": "outputs", "label": "output {n}"}], "value": "next: {next}"},
    "flipflop": {"label": "Flip-flop", "noun": "block", "level": "more", "kw": ["flip", "alternate", "toggle"],
      "in": [{"id": "in", "label": "flip"}], "out": [{"id": "a", "label": "A"}, {"id": "b", "label": "B"}],
      "value": "next: {next}"},
    "signal": {"label": "Signal", "noun": "signal", "level": "more", "kw": ["broadcast", "event", "send"],
      "in": [{"id": "send", "label": "send it"}], "out": [{"id": "sent", "label": "it is sent"}], "value": ""},
    "phase": {"label": "Phase set", "noun": "phases", "level": "more", "kw": ["stage", "chapter", "mode", "position"],
      "in": [{"id": "goto", "many": "list", "label": "go to {name}"}, {"id": "next", "label": "next phase"},
        {"id": "previous", "label": "previous phase"}],
      "out": [{"id": "enters", "many": "list", "label": "enters {name}"}, {"id": "leaves", "many": "list", "label": "leaves {name}"}],
      "value": "Phase: {phase}"},
    "group": {"label": "Group", "noun": "group", "level": "more", "kw": ["set", "squad", "team", "many"],
      "in": [], "out": [], "value": ""},
    "point": {"label": "Point", "noun": "point", "level": "more", "kw": ["spot", "place", "marker"],
      "in": [], "out": [{"id": "enter", "label": "JC comes here"}], "value": ""}
  },
