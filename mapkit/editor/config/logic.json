    {"id": "beam", "noun": "beam", "classes": ["BeamTrigger"], "outputs": ["laser", "near"], "inputs": ["off", "on", "sound"],
     "note": "Not a LaserTrigger: before, it fell in 'zone' and offered 'leave', which it never sends."},
    {"id": "alarm", "noun": "alarm", "classes": ["AlarmUnit"], "outputs": ["alarm", "near"], "inputs": ["on", "off", "sound", "explode", "effect"]},
    {"id": "camera", "classes": ["SecurityCamera"], "outputs": ["near"], "inputs": ["off", "on", "sound", "explode", "effect"],
     "note": "A camera fires no event: it only makes the AI alarm noise."},
    {"id": "turret", "noun": "turret", "classes": ["AutoTurret"], "outputs": ["near"], "inputs": ["off", "on", "sound", "explode", "effect"]},
    {"id": "soundfx", "noun": "sound effect", "classes": ["UCSoundFX"], "outputs": ["enter", "leave"], "inputs": ["on", "off"],
     "note": "off: UnTrigger, a sound effect that plays again by itself (its More sounds' Repeats every) stops."},
    {"id": "zone", "noun": "zone", "classes": ["Trigger"], "outputs": ["enter", "leave"], "inputs": ["on", "off"]},
    {"id": "targettrigger", "classes": ["AllianceTrigger", "OrdersTrigger", "InterpolateTrigger", "SequenceTrigger",
       "UnTrigger", "RevStateTrigger", "ActorAppearTrigger", "AnimTrigger", "AnimTweenBlendTrigger", "ElevatorTrigger",
       "PawnAppearTrigger", "PhysicsTrigger", "SkinColourTrigger", "TriggerTrigger", "UnlitTrigger"],
     "outputs": ["near"], "inputs": ["on"],
     "note": "Their Event is a list of targets, not an output: hooking it would break them (UCLink.AimsItsEvent). Revision's MoreTriggers are each named: the editor may not know their chain."},
    {"id": "switchtrigger", "classes": ["DamageTriggerDirect", "LOSHateTrigger"], "outputs": ["near"], "inputs": ["on", "off"],
     "note": "Revision's: their Event is their targets too, and they are switched off (UnTrigger)."},
    {"id": "moretrigger", "classes": ["MoreTriggers", "ActorDestroyTrigger", "CreditsTrigger", "EnergyTrigger",
       "ExplosionTrigger", "FlaggedActorTrigger", "FragmentTrigger", "HealthTrigger", "OrderPawnTrigger", "PawnSpawnTrigger",
       "RandomTrigger", "SetGoalTrigger", "SheepsGiveItemTrigger", "SpawnTrigger"],
     "outputs": ["leave", "near"], "inputs": ["on"],
     "note": "Revision's other MoreTriggers: they never send their Event when JC walks in, only untrigger it when he walks out."},
    {"id": "light", "noun": "light", "classes": ["Light"], "outputs": [], "inputs": ["lighttoggle", "lighton", "lightoff"]},
    {"id": "switchlight", "classes": ["AlarmLight", "CageLight"], "outputs": ["used", "gone", "near"],
