//=============================================================================
// UCMenuLook - the project's own main menu (File > Main menu... of the map editor, main_menu.py).
// GENERATED by the map editor from main-menu.json: do not edit by hand. Off (bEnabled False) until the
// project makes one. Read by UCMenuRoot (it puts UCMainMenu in place of the game's), UCMainMenu (what it
// shows), UCNewGame (the map a new game starts on), UCBoot (the menu's own map: UCMenuStage).
//
//   Actions: 0 new game, 1 load game, 2 save game, 3 settings, 4 back to the game, 5 the main menu (its map),
//            6 exit, 7 one of the project's maps (Targets)
//   Shows:   0 always, 1 on the menu's own map only, 2 during the game only
//=============================================================================
class UCMenuLook extends Object
	abstract;

var bool   bEnabled;
var string MenuMap;              // the map behind the menu
var string StartMap;             // the map a new game starts on
var bool   bCharacterScreens;    // New game: the game's difficulty and character screens first
var byte   CameraMove;           // 0 still, 1 a slow sway of the view
var string Title;
var byte   TitleFont;            // UCMainMenu.FontOf
var Color  TitleColor;
var bool   bLogo;                // UCMenuLogo, imported below
var int    LogoW, LogoH;         // the picture's own size in the texture (pixels)
var float  LogoScale;
var byte   Align;                // 0 left, 1 centre, 2 right
var float  PosX, PosY;           // where the logo and the buttons start: 0..1 of the screen
var byte   ButtonLook;           // 0 the game's buttons, 1 text only
var byte   ButtonFont;
var int    ButtonWidth;
var Color  TextColor, HoverColor, DisabledColor;
var bool   bShade;               // a dark band behind the buttons
var string Footer;
var int    NumButtons;
var string Labels[12];
var byte   Actions[12];
var byte   Shows[12];
var string Targets[12];

defaultproperties
{
     bEnabled=False
     bCharacterScreens=True
     TitleColor=(R=255,G=255,B=255)
     LogoScale=1.000000
     PosX=0.080000
     PosY=0.350000
     ButtonWidth=245
     TextColor=(R=200,G=200,B=200)
     HoverColor=(R=255,G=255,B=255)
     DisabledColor=(R=90,G=90,B=90)
     bShade=True
}
